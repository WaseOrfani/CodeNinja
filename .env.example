# AfghanFood.de - Umgebungsvariablen
# Kopieren Sie diese Datei nach .env und passen Sie die Werte an

# Backend Konfiguration
MONGO_URL=mongodb://mongodb:27017
DB_NAME=afghanfood
JWT_SECRET=ihr-sicheres-geheimes-passwort-hier-aendern

# Frontend Konfiguration
# Ändern Sie diese URL auf Ihre Domain
BACKEND_URL=http://localhost:8001

# CORS - Erlaubte Origins (kommagetrennt)
CORS_ORIGINS=http://localhost,http://localhost:3000,http://localhost:80

# Ports
HTTP_PORT=80
HTTPS_PORT=443
