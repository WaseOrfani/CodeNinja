# ORIA FRESH - Root .htaccess für Apache
# Kombiniertes Frontend + Backend Routing

RewriteEngine On

# HTTPS erzwingen (für Produktion einkommentieren)
# RewriteCond %{HTTPS} off
# RewriteRule ^(.*)$ https://%{HTTP_HOST}%{REQUEST_URI} [L,R=301]

# CORS Headers für API
<IfModule mod_headers.c>
    Header always set Access-Control-Allow-Origin "*"
    Header always set Access-Control-Allow-Methods "GET, POST, PUT, DELETE, OPTIONS"
    Header always set Access-Control-Allow-Headers "Content-Type, Authorization"
</IfModule>

# Handle OPTIONS preflight
RewriteCond %{REQUEST_METHOD} OPTIONS
RewriteRule ^(.*)$ $1 [R=200,L]

# Existierende Dateien direkt ausliefern
RewriteCond %{REQUEST_FILENAME} -f [OR]
RewriteCond %{REQUEST_FILENAME} -d
RewriteRule ^ - [L]

# API Requests → PHP Backend
RewriteRule ^api/(.*)$ api/index.php [QSA,L]

# Alles andere → React Frontend (SPA)
RewriteRule ^ index.html [L]
